# syntax=docker/dockerfile:1
# Builds against the published ai.pipestream.integration snapshots, or
# against a local grpc-integration checkout when one is passed as a named
# build context (it replaces the empty "integration" stage below):
#   docker build --build-context integration=../grpc-integration -f Dockerfile.microsoft .
FROM scratch AS integration

FROM eclipse-temurin:25-jdk AS build
ARG GRADLE_MAX_WORKERS=2
ENV JAVA_TOOL_OPTIONS="-XX:ActiveProcessorCount=2"
COPY --from=integration . /src/grpc-integration
WORKDIR /src/grpc-microsoft
COPY . .
RUN --mount=type=cache,target=/root/.gradle ./gradlew --no-daemon --max-workers=${GRADLE_MAX_WORKERS} build :grpc-microsoft-service:installDist :grpc-microsoft-connector:installDist && \
    find . -path '*/build/test-results/test/TEST-*.xml' -exec awk -F '"' \
    '/<testsuite / { for (i=1; i<NF; i++) { if ($i ~ / tests=$/) tests+=$(i+1); if ($i ~ / failures=$/) failures+=$(i+1); if ($i ~ / errors=$/) errors+=$(i+1); if ($i ~ / skipped=$/) skipped+=$(i+1) } } END { printf "CONTAINER_TEST_TOTAL tests=%d failures=%d errors=%d skipped=%d\n", tests, failures, errors, skipped; if (tests == 0 || failures != 0 || errors != 0) exit 1 }' {} +

FROM eclipse-temurin:25-jre
COPY --from=build /src/grpc-microsoft/grpc-microsoft-service/build/install/grpc-microsoft-service /opt/microsoft
USER 65532:65532
EXPOSE 9096
ENTRYPOINT ["/opt/microsoft/bin/grpc-microsoft-service"]
